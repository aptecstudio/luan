#!/bin/sh
# project-os — keys of the encrypted data partition (step 4d, D-058).
#
# Usage: project-os-data-key status|setup|password|recovery-key
#   status         which keys open the data partition, and whether it is protected
#   setup          first protection: creates the recovery key, sets the password and
#                  removes the empty key the partition was created with
#   password       changes the password (asks the current password or the recovery key)
#   recovery-key   replaces the recovery key with a new one (asks the password)
#
# The data partition is created on first boot with an empty key (D-026): until
# "setup" is run, anyone with the disk can read the data. At boot the password, or the
# recovery key in its place, is asked before the system starts.
#
# Every change is checked before the old key is removed: the partition must never be
# left with keys nobody knows. (systemd-cryptenroll --wipe-slot does not check the
# unlock key it is given: a wrong one still wiped the empty key, seen in QEMU.)
set -eu

DEVICE=/dev/disk/by-partlabel/data

# Key derivation of the password (Argon2id): memory limited to a quarter of the RAM,
# at most 1 GiB, so that the initramfs of an old PC with little memory can still
# unlock it (D-044: the default used up to 893 MB in a 2 GB VM). Time: cryptsetup's
# default, about 2 s on this PC.
ram_kib=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
pbkdf_memory_kib=$((ram_kib / 4))
if [ "$pbkdf_memory_kib" -gt 1048576 ]; then
    pbkdf_memory_kib=1048576
fi

usage() {
    sed -n '4,9s/^# \{0,1\}//p' "$0"
}

die() {
    echo "Error: $*" >&2
    exit 1
}

# Secrets live only in a private directory in /run (RAM), removed on exit
work=""
cleanup() {
    if [ -n "$work" ]; then
        rm -rf "$work"
    fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM

make_work_dir() {
    umask 077
    work=$(mktemp -d /run/project-os-data-key.XXXXXX)
}

# Keyslot numbers, one per line: all of them, and those of the recovery key (the
# keyslots of the systemd-recovery tokens). The others hold passwords (or the empty key).
all_slots() {
    cryptsetup luksDump "$DEVICE" |
        awk '/^Keyslots:/ { k = 1; next } /^[A-Z]/ { k = 0 }
             k && /^  [0-9]+: / { sub(":", "", $1); print $1 }'
}

recovery_slots() {
    cryptsetup luksDump "$DEVICE" |
        awk '/^Tokens:/ { t = 1; next } /^[A-Z]/ { t = 0 }
             t && /^  [0-9]+: / { recovery = ($2 == "systemd-recovery") }
             t && recovery && /Keyslot:/ { print $2 }'
}

password_slots() {
    recovery=$(recovery_slots)
    for slot in $(all_slots); do
        case " $(echo "$recovery" | tr '\n' ' ') " in
            *" $slot "*) ;;
            *) echo "$slot" ;;
        esac
    done
}

# Removes the keyslots given after the key file $1 (and their tokens). Called only after
# the keys that stay have been checked.
wipe_slots() {
    key_file=$1
    shift
    for slot in "$@"; do
        systemd-cryptenroll --wipe-slot="$slot" --unlock-key-file="$key_file" \
            "$DEVICE" >"$work/wipe.log" 2>&1 ||
            die "cannot remove key slot $slot: $(cat "$work/wipe.log")"
    done
}

# Slot opened by the key in file $1, or nothing if the key is wrong
slot_of_key() {
    cryptsetup open --test-passphrase --verbose --key-file="$1" "$DEVICE" 2>/dev/null |
        awk '/^Key slot [0-9]+ unlocked/ { print $3 }'
}

# Reads a secret from the terminal without showing it, into file $2 (no newline)
read_secret() {
    printf '%s' "$1"
    stty -echo 2>/dev/null || true
    IFS= read -r secret || secret=""
    stty echo 2>/dev/null || true
    echo
    printf '%s' "$secret" >"$2"
    secret=""
}

# Asks a new password twice into file $1
read_new_password() {
    while :; do
        read_secret "New password: " "$1"
        if [ "$(wc -c <"$1")" -lt 8 ]; then
            echo "The password must have at least 8 characters."
            continue
        fi
        read_secret "Repeat the password: " "$work/repeat"
        if cmp -s "$1" "$work/repeat"; then
            rm -f "$work/repeat"
            return 0
        fi
        echo "The two passwords are different, try again."
    done
}

# Shows the recovery key in file $1 and asks to type it back, to be sure it was saved.
# The comparison ignores dashes, spaces and letter case.
confirm_recovery_key() {
    echo
    echo "Recovery key:"
    echo
    echo "    $(cat "$1")"
    echo
    echo "Write it down and keep it in a safe place, away from this PC. It opens the"
    echo "data if the password is forgotten: without both, the data is lost."
    echo "At boot it can be typed in place of the password."
    echo
    expected=$(tr -d -- '- \n' <"$1" | tr '[:upper:]' '[:lower:]')
    while :; do
        printf 'Type the recovery key to confirm you saved it: '
        IFS= read -r typed || die "no input"
        typed=$(printf '%s' "$typed" | tr -d -- '- ' | tr '[:upper:]' '[:lower:]')
        if [ "$typed" = "$expected" ]; then
            return 0
        fi
        echo "It does not match, try again."
    done
}

# Writes the recovery key printed by systemd-cryptenroll (stdout) into file $1
# without its final newline: a key file is used byte by byte.
save_recovery_key() {
    tr -d '\n' <"$work/cryptenroll.out" >"$1"
    rm -f "$work/cryptenroll.out"
    grep -qE '^[a-z]{8}(-[a-z]{8}){7}$' "$1" || die "unexpected recovery key format"
}

check_device() {
    [ "$(id -u)" -eq 0 ] || die "run it as root"
    [ -b "$DEVICE" ] || die "data partition not found ($DEVICE)"
}

cmd_status() {
    check_device
    recoveries=$(recovery_slots | wc -l)
    echo "Data partition: $(readlink -f "$DEVICE")"
    if [ "$recoveries" -eq 0 ]; then
        echo "NOT PROTECTED: the data partition still has its empty key."
        echo "Run: project-os-data-key setup"
        exit 2
    fi
    echo "Protected: $(password_slots | wc -l) password(s), $recoveries recovery key(s)."
}

cmd_setup() {
    check_device
    if [ -n "$(recovery_slots)" ]; then
        die "already protected; use 'password' or 'recovery-key' to change the keys"
    fi
    old_slots=$(all_slots)
    make_work_dir

    echo "This protects the data partition with a password and a recovery key."
    echo "From the next boot, the password is asked before the system starts."
    echo "(Keyboard layout at boot: the same as this console.)"
    echo

    # 1. Recovery key, unlocking with the empty key the partition was created with
    systemd-cryptenroll --recovery-key --unlock-key-file=/dev/null "$DEVICE" \
        >"$work/cryptenroll.out" 2>"$work/cryptenroll.err" ||
        die "cannot use the empty key: $(cat "$work/cryptenroll.err")"
    save_recovery_key "$work/recovery"

    # Undo the new recovery key if setup does not complete, so that it can be run again
    trap 'systemd-cryptenroll --wipe-slot=recovery --unlock-key-file=/dev/null \
              "$DEVICE" >/dev/null 2>&1 || true; cleanup' EXIT

    confirm_recovery_key "$work/recovery"

    # 2. Password
    echo
    read_new_password "$work/password"
    echo "Setting the password (a few seconds)..."
    cryptsetup luksAddKey --pbkdf argon2id --pbkdf-memory "$pbkdf_memory_kib" \
        --key-file="$work/recovery" "$DEVICE" "$work/password"

    # 3. Check both keys, then remove the empty key (the slots that existed before)
    [ -n "$(slot_of_key "$work/password")" ] || die "the new password does not work"
    [ -n "$(slot_of_key "$work/recovery")" ] || die "the recovery key does not work"
    trap cleanup EXIT
    # shellcheck disable=SC2086 # one argument per slot number
    wipe_slots "$work/password" $old_slots

    [ "$(password_slots | wc -l)" -eq 1 ] && [ "$(recovery_slots | wc -l)" -eq 1 ] ||
        die "unexpected key slots, check with: cryptsetup luksDump $DEVICE"
    echo
    echo "Done: the data partition is protected by the password and the recovery key."
}

cmd_password() {
    check_device
    [ -n "$(recovery_slots)" ] || die "not protected yet; run 'setup' first"
    make_work_dir

    read_secret "Current password (or recovery key): " "$work/current"
    current_slot=$(slot_of_key "$work/current")
    if [ -z "$current_slot" ]; then
        # A recovery key may have been typed with a final space or in capitals
        tr -d ' \n' <"$work/current" | tr '[:upper:]' '[:lower:]' >"$work/current.key"
        mv "$work/current.key" "$work/current"
        current_slot=$(slot_of_key "$work/current")
    fi
    [ -n "$current_slot" ] || die "wrong password or recovery key"
    old_slots=$(password_slots)

    read_new_password "$work/password"
    echo "Setting the password (a few seconds)..."
    cryptsetup luksAddKey --pbkdf argon2id --pbkdf-memory "$pbkdf_memory_kib" \
        --key-file="$work/current" "$DEVICE" "$work/password"
    new_slot=$(slot_of_key "$work/password")
    [ -n "$new_slot" ] || die "the new password does not work; the old one is kept"

    # shellcheck disable=SC2046 # one argument per slot number
    wipe_slots "$work/password" $(echo "$old_slots" | grep -vx "$new_slot")
    echo "Done: password changed."
}

cmd_recovery_key() {
    check_device
    [ -n "$(recovery_slots)" ] || die "not protected yet; run 'setup' first"
    make_work_dir

    read_secret "Password: " "$work/password"
    slot=$(slot_of_key "$work/password")
    [ -n "$slot" ] || die "wrong password"
    case " $(recovery_slots | tr '\n' ' ') " in
        *" $slot "*) die "that is the recovery key: type the password" ;;
    esac
    old_slots=$(recovery_slots)

    # New recovery key first; the old one is removed only after the new one is
    # confirmed and checked
    systemd-cryptenroll --recovery-key --unlock-key-file="$work/password" "$DEVICE" \
        >"$work/cryptenroll.out" 2>"$work/cryptenroll.err" ||
        die "cannot create the recovery key: $(cat "$work/cryptenroll.err")"
    save_recovery_key "$work/recovery"
    new_slot=$(slot_of_key "$work/recovery")
    [ -n "$new_slot" ] || die "the new recovery key does not work; the old one is kept"
    confirm_recovery_key "$work/recovery"

    # shellcheck disable=SC2046 # one argument per slot number
    wipe_slots "$work/password" $(echo "$old_slots" | grep -vx "$new_slot")
    echo "Done: the old recovery key no longer works."
}

case "${1:-}" in
    status) cmd_status ;;
    setup) cmd_setup ;;
    password) cmd_password ;;
    recovery-key) cmd_recovery_key ;;
    --help|-h) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
