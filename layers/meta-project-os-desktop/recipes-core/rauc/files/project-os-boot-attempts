#!/bin/sh
# project-os — give the booted slot its 3 boot attempts back (D-058).
#
# Run after rauc-mark-good has confirmed the slot (ExecStartPost). GRUB counts the boot
# attempts of each slot in grubenv (A_LEFT, B_LEFT) and gives a slot up after 3 boots
# that did not complete; a boot that completes starts the count again.
set -eu

GRUBENV=/efi/EFI/BOOT/grubenv

slot=""
read -r cmdline </proc/cmdline
for arg in $cmdline; do
    case "$arg" in
        rauc.slot=*) slot=${arg#rauc.slot=} ;;
    esac
done

case "$slot" in
    A|B) grub-editenv "$GRUBENV" set "${slot}_LEFT=3" ;;
    *)
        echo "No A/B slot on the kernel command line (rauc.slot): nothing to do" >&2
        ;;
esac
